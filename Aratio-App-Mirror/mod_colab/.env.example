# =====================================================
# CONFIGURACIÓN DEL SISTEMA
# Copiar este archivo a .env y configurar valores
# =====================================================

# Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aratio
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Aplicación
APP_NAME="Sistema de Gestión de Colaboradores"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Seguridad
SECURITY_KEY=tu-clave-secreta-256-bits-cambiar-en-produccion
CSRF_TOKEN_NAME=csrf_token
SESSION_NAME=aratio_session

# Sesiones
SESSION_LIFETIME=1800
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Autenticación
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_COST=12

# 2FA
2FA_ENABLED=true
2FA_ISSUER=GestionColaboradores

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_TIME=900
RATE_LIMIT_API=100

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@aratio.com
MAIL_FROM_NAME="Sistema A Ratio"
MAIL_ENCRYPTION=tls

# Archivos
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,xlsx,xls,csv
UPLOAD_PATH=public/uploads

# Logs
LOG_LEVEL=info
LOG_FILE=storage/logs/app.log
LOG_SECURITY_FILE=storage/logs/security.log
LOG_MAX_SIZE=10485760

# Cache
CACHE_ENABLED=true
CACHE_LIFETIME=3600
CACHE_PATH=storage/cache

# API
API_ENABLED=true
API_VERSION=v1
API_RATE_LIMIT=100

# Timezone
APP_TIMEZONE=America/Bogota
